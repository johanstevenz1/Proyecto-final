# Copia este archivo como backend/.env (no se versiona) o define estas variables en el sistema.
MONGODB_URI=mongodb://localhost:27017/jovanpets
# Minimo 32 caracteres; genera uno propio, por ejemplo con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32-o-mas-caracteres
JWT_MINUTOS=30
CORS_ORIGENES=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Administrador inicial de desarrollo (cambia la contrasena en tu entorno)
ADMIN_EMAIL=admin@jovanpets.local
ADMIN_PASSWORD=AdminLocal-2026
ADMIN_NOMBRE=Administrador Jovan Pets
# true crea servicios y productos de ejemplo si las colecciones estan vacias
APP_DATOS_INICIALES=true
